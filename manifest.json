{
  "manifest_version": 3,
  "name": "LLM Scroll Navigator",
  "version": "1.0",
  "description": "Keyboard and UI navigation for Prompts and Code Blocks on ChatGPT, Claude, and Gemini.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://aistudio.google.com/*"
      ],
      "js": [
        "scripts/config.js",
        "scripts/utils.js",
        "scripts/navigation.js",
        "scripts/ui.js",
        "scripts/minimap.js",
        "scripts/main.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}